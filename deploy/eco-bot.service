# Запуск бота как службы systemd (Linux / Raspberry Pi).
# Поправьте пути и пользователя, затем:
#   sudo cp deploy/eco-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now eco-bot
#   journalctl -u eco-bot -f      # логи
[Unit]
Description=Eco bot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/second-year-final-project
ExecStart=/home/pi/second-year-final-project/.venv/bin/python main.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
